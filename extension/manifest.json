{
  "manifest_version": 3,
  "name": "ServiceNow Ticket Recommender",
  "version": "0.1.0",
  "description": "KB-grounded resolution suggestions for ServiceNow incidents. An independent tool built by a Rutgers OIT team member.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["sidePanel", "activeTab"],
  "host_permissions": [
    "https://rutgers.service-now.com/*",
    "http://localhost:8420/*",
    "https://servicenow.smafnanhaider.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://rutgers.service-now.com/*"],
      "js": ["main_world_bridge.js"],
      "world": "MAIN"
    },
    {
      "matches": ["https://rutgers.service-now.com/*"],
      "js": ["content_script.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
